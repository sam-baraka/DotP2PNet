{
  "Dotp2pNet": {
    "Network": {
      "ListenPort": 6881,
      "MaxConnections": 50,
      "ConnectionTimeoutSeconds": 30,
      "EnableDht": true,
      "DhtPort": 6881
    },
    "Storage": {
      "DownloadDirectory": "./downloads",
      "TempDirectory": "./temp",
      "MaxDiskSpaceBytes": 0,
      "PieceLengthBytes": 262144
    },
    "Logging": {
      "LogDirectory": "~/.dotp2pnet/logs",
      "MinimumLevel": "Information",
      "EnableConsole": true,
      "EnableFile": true
    },
    "Peer": {
      "PeerIdPrefix": "-DP0001-",
      "MaxRequestsPerPeer": 5,
      "RequestTimeoutSeconds": 30,
      "EnableChoking": true,
      "UnchokedPeers": 4
    }
  }
}
